# Axiom Aegis v3.0 - Environment Configuration Template
# ======================================================
# Copy this file to .env and fill in your settings
# 
# All settings are optional - use defaults if not specified
# 
# Version: 3.0.0
# Last Updated: 2026-09-01

# =============================================================================
# CORE SETTINGS
# =============================================================================

# Port for API server (if enabled)
PORT=8000

# API key for authentication (optional)
API_KEY=your_api_key_here

# Database connection string (optional)
DATABASE_URL=sqlite:///axiom_audit.db

# =============================================================================
# LOGGING
# =============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file path (optional)
LOG_FILE=outputs/axiom.log

# Enable verbose logging
VERBOSE=false

# =============================================================================
# OUTPUT CONFIGURATION
# =============================================================================

# Output directory for reports
OUTPUT_DIR=outputs

# Cache directory for analysis results
CACHE_DIR=.axiom_cache

# Format for reports: json, markdown, html, text
REPORT_FORMAT=text

# =============================================================================
# ANALYSIS SETTINGS
# =============================================================================

# Confidence threshold for findings (0.0 - 1.0)
CONFIDENCE_THRESHOLD=0.7

# Enable pattern mining
PATTERN_MINING=true

# Enable cross-module analysis
CROSS_MODULE=true

# Enable fix suggestions
FIX_GENERATION=true

# Enable benchmark analysis
BENCHMARK=true

# Enable interactive mode
INTERACTIVE=false

# =============================================================================
# SECURITY SETTINGS
# =============================================================================

# Enable dangerous call detection
SECURITY_CHECK=true

# Block eval/exec calls
BLOCK_EVAL=true

# Block os.system calls
BLOCK_OS_SYSTEM=true

# Maximum file size for analysis (bytes)
MAX_FILE_SIZE=104857600  # 100MB

# =============================================================================
# PERFORMANCE SETTINGS
# =============================================================================

# Maximum concurrent file analysis
MAX_CONCURRENT=4

# Timeout for single file analysis (seconds)
ANALYSIS_TIMEOUT=300

# Enable parallel processing
PARALLEL=true

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================

# Enable development mode (slower, more verbose)
DEV_MODE=false

# Enable mutation testing
MUTATION_TESTING=false

# Code coverage threshold (%)
COVERAGE_THRESHOLD=80

# =============================================================================
# OPTIONAL DEPENDENCIES
# =============================================================================

# GUI mode (optional)
GUI_MODE=false

# API server (optional)
API_SERVER=false

# =============================================================================
# VERSION
# =============================================================================

# Current version
VERSION=3.0.0
