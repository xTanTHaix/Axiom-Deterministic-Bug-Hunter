# Auto-detect text files and normalize line endings (LF)
* text=auto eol=lf

# Explicit text file definitions
*.py text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.env text eol=lf
*.env.example text eol=lf
*.txt text eol=lf
*.xml text eol=lf

# Binary file definitions
*.db binary
*.sqlite binary
*.sqlite3 binary
*.wasm binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
